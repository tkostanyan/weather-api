# Weather API Configuration
# Copy this file to .env and fill in your values

# ===================
# Environment Setting
# ===================
# Options: local, prod, test
# - local: Uses MongoDB, Local File Storage, Redis
# - prod: Uses DynamoDB, S3, ElastiCache
# - test: Uses in-memory implementations
ENVIRONMENT=local

# ===================
# Weather API
# ===================
# Get your free API key at: https://openweathermap.org/api
WEATHER_API_KEY=your_api_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ===================
# Cache Configuration
# ===================
CACHE_TTL_SECONDS=300

# Redis (Local Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ElastiCache (Production)
ELASTICACHE_HOST=
ELASTICACHE_PORT=6379
ELASTICACHE_PASSWORD=

# ===================
# Storage Configuration
# ===================

# Local File Storage
DATA_DIR=./data

# S3 (Production)
S3_BUCKET_NAME=

# ===================
# Database Configuration
# ===================

# MongoDB (Local Development)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=weather_api

# DynamoDB (Production)
DYNAMODB_TABLE_NAME=weather-events

# ===================
# AWS Configuration (Production)
# ===================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For LocalStack testing
AWS_ENDPOINT_URL=

# ===================
# Application Settings
# ===================
RATE_LIMIT_PER_MINUTE=100
DEBUG=false
LOG_LEVEL=INFO

